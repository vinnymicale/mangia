# Where the SQLite database lives. In Docker this is a mounted volume.
DATABASE_URL="file:/data/mangia.db"

# LLM provider: "gemini" or "openai-compatible".
LLM_PROVIDER=gemini
LLM_API_KEY=
# Defaults to gemini-2.5-flash for gemini, gpt-4o-mini for openai-compatible.
LLM_MODEL=gemini-2.5-flash
# Only for openai-compatible (Ollama, LM Studio, vLLM…).
LLM_BASE_URL=
