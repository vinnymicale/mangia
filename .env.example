# Where the SQLite database lives. In Docker this is a mounted volume.
DATABASE_URL="file:/data/mangia.db"

# LLM provider: "gemini" or "openai-compatible". All of these are also
# settable at /settings, where a change takes effect without a restart.
LLM_PROVIDER=gemini
LLM_API_KEY=
# Defaults to gemini-2.5-flash for gemini, gpt-4o-mini for openai-compatible.
LLM_MODEL=gemini-2.5-flash
# Only for openai-compatible (Ollama, LM Studio, vLLM…).
LLM_BASE_URL=

# Google Drive backups. Also settable at /settings, which is the easier path:
# there you pick the key file instead of pasting JSON, and a change takes
# effect without a restart. These are the fallback for a fresh container.
# The service account's key file, as JSON, or a path to it.
GOOGLE_DRIVE_CREDENTIALS=
# The folder to upload into. Share it with the service account's address.
GOOGLE_DRIVE_FOLDER_ID=
# Hours between backups. Defaults to 24.
GOOGLE_DRIVE_BACKUP_INTERVAL_HOURS=24
