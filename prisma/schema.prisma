generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Recipe {
  id           String    @id @default(cuid())
  title        String
  description  String?
  sourceUrl    String?
  prepMinutes  Int?
  cookMinutes  Int?
  servings     Int?
  instructions String    @default("")
  notes        String?
  lastCookedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ingredients       RecipeIngredient[]
  tags              RecipeTag[]
  itemSources       ShoppingItemSource[]
  cookLogs          CookLog[]
  photo             RecipePhoto?
  nutritionOverride RecipeNutritionOverride?

  @@index([title])
  @@index([createdAt])
}

/**
 * The photo a recipe was read from, kept only when the cook asks for it.
 *
 * A row rather than a file on disk: the backup serialises the database to JSON
 * rather than copying the SQLite file, so a row travels with the backup and a
 * file in /data would silently not.
 */
model RecipePhoto {
  id        String   @id @default(cuid())
  recipeId  String   @unique
  data      Bytes
  mimeType  String
  createdAt DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

/**
 * Per-serving nutrition the cook (or the source page) gave for a recipe. When
 * present it wins over the per-ingredient estimate, which is still computed
 * for the breakdown.
 */
model RecipeNutritionOverride {
  id        String   @id @default(cuid())
  recipeId  String   @unique
  kcal      Float?
  protein   Float?
  carbs     Float?
  fat       Float?
  fiber     Float?
  sugar     Float?
  sodium    Float?
  note      String?
  updatedAt DateTime @updatedAt

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model RecipeIngredient {
  id           String  @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Float?
  unit         String?
  note         String?
  rawText      String
  sortOrder    Int

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([recipeId])
  @@index([ingredientId])
}

model Ingredient {
  id       String  @id @default(cuid())
  name     String  @unique
  category String?

  aliases           IngredientAlias[]
  recipeIngredients RecipeIngredient[]
  shoppingItems     ShoppingListItem[]
  pantryStaple      PantryStaple?
  nutrition         IngredientNutrition?
  unitWeights       IngredientUnitWeight[]

  @@index([name])
}

/**
 * What 100 g of an ingredient contains, resolved once and shared by every
 * recipe that uses it. Sodium is mg, the rest grams.
 *
 * `source` is usda | ai | manual | none | unmatched. `none` is the cook saying
 * "leave it blank" and is never asked about again; `unmatched` is the app
 * having tried and failed, and shows as a gap. No row at all means nobody has
 * tried yet, which is what lets the resolver retry after an outage.
 */
model IngredientNutrition {
  id             String   @id @default(cuid())
  ingredientId   String   @unique
  kcal           Float?
  protein        Float?
  carbs          Float?
  fat            Float?
  fiber          Float?
  sugar          Float?
  sodium         Float?
  source         String
  fdcId          Int?
  fdcDescription String?
  updatedAt      DateTime @updatedAt

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

/**
 * How many grams one of `unit` of an ingredient weighs: "1 cup flour = 125 g".
 *
 * `unit` is canonical, or '' for a bare count ("2 onions"). The empty string
 * rather than null because SQLite treats NULLs as distinct in a unique index,
 * which would let the bare-count row be inserted twice; the data layer
 * translates to null at the boundary.
 */
model IngredientUnitWeight {
  id           String   @id @default(cuid())
  ingredientId String
  unit         String
  grams        Float?
  source       String
  updatedAt    DateTime @updatedAt

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, unit])
}

model IngredientAlias {
  id           String @id @default(cuid())
  ingredientId String
  alias        String @unique

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
}

model Tag {
  id      String      @id @default(cuid())
  name    String      @unique
  kind    String      @default("freeform")
  recipes RecipeTag[]
}

model RecipeTag {
  recipeId String
  tagId    String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
}

/// One entry per time the dish was actually made. Recipe.lastCookedAt is a
/// single overwritable field, so it can answer "when did I last make this?"
/// but loses everything before that. The log keeps the whole run, which is what
/// makes rotation and "not cooked in a year" answerable -- and gives a note
/// somewhere to live that belongs to one cook rather than the recipe.
model CookLog {
  id       String   @id @default(cuid())
  recipeId String
  cookedAt DateTime @default(now())
  note     String?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, cookedAt])
  @@index([cookedAt])
}

model ShoppingList {
  id        String             @id @default(cuid())
  name      String
  createdAt DateTime           @default(now())
  items     ShoppingListItem[]
}

model ShoppingListItem {
  id           String  @id @default(cuid())
  listId       String
  ingredientId String?
  quantity     Float?
  unit         String?
  checked      Boolean @default(false)
  manualText   String?
  note         String?
  sortOrder    Int     @default(0)

  list       ShoppingList         @relation(fields: [listId], references: [id], onDelete: Cascade)
  ingredient Ingredient?          @relation(fields: [ingredientId], references: [id])
  sources    ShoppingItemSource[]

  @@index([listId])
}

model ShoppingItemSource {
  shoppingListItemId String
  recipeId           String

  item   ShoppingListItem @relation(fields: [shoppingListItemId], references: [id], onDelete: Cascade)
  recipe Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([shoppingListItemId, recipeId])
}

model PantryStaple {
  id           String @id @default(cuid())
  name         String @unique
  ingredientId String @unique

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

/// Editable application configuration, one row per key. Rows win over the
/// matching environment variable so the settings page is authoritative once
/// used; an installation that never opens it keeps behaving as it always did.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
