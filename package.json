  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run db:e2e && playwright test",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e",
    "db:e2e": "rm -f e2e.db e2e.db-journal e2e.db-wal e2e.db-shm && DATABASE_URL=file:./e2e.db prisma db push && DATABASE_URL=file:./e2e.db prisma db execute --file ./prisma/migrations/manual/fts.sql",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
